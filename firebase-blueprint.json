{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "A psychological counseling service offered by the consultant.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the service."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the service."
        },
        "icon": {
          "type": "string",
          "description": "The name of the Lucide icon to use."
        },
        "order": {
          "type": "number",
          "description": "The display order of the service."
        }
      },
      "required": ["title", "description", "icon", "order"]
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global configuration and content for the website.",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "aboutText": { "type": "string" },
        "aboutImage": { "type": "string" },
        "email": { "type": "string" },
        "instagram": { "type": "string" },
        "consultantName": { "type": "string" },
        "consultantTitle": { "type": "string" }
      },
      "required": ["heroTitle", "heroSubtitle", "aboutText", "email", "instagram", "consultantName"]
    },
    "Appointment": {
      "title": "Appointment Request",
      "description": "A request for a counseling session submitted by a potential client.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "service": { "type": "string", "enum": ["Çocuk Danışmanlığı", "Ergen Danışmanlığı", "Yetişkin Danışmanlığı", "Diğer"] },
        "message": { "type": "string" },
        "preferredDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Bekliyor", "İletişime Geçildi", "Tamamlandı"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "service", "status", "createdAt"]
    }
  },
  "firestore": {
    "services": {
      "schema": "Service",
      "description": "Collection of counseling services."
    },
    "settings": {
      "schema": "SiteSettings",
      "description": "Global site settings (singleton collection)."
    },
    "appointments": {
      "schema": "Appointment",
      "description": "Collection of appointment requests."
    }
  }
}

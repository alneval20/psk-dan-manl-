// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: services
// Document ID: auto-generated
// Fields:
//   - title: string (required)
//   - description: string (required)
//   - icon: string (required)
//   - order: number (required)
//
// Collection: settings
// Document ID: 'main'
// Fields:
//   - heroTitle: string (required)
//   - heroSubtitle: string (required)
//   - aboutText: string (required)
//   - aboutImage: string (optional)
//   - email: string (required)
//   - instagram: string (required)
//   - consultantName: string (required)
//   - consultantTitle: string (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "alneval20@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidService(data) {
      return data.keys().hasAll(['title', 'description', 'icon', 'order']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.description is string && data.description.size() > 0 && data.description.size() < 2000 &&
             data.icon is string &&
             data.order is number;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['heroTitle', 'heroSubtitle', 'aboutText', 'email', 'instagram', 'consultantName', 'consultantTitle']) &&
             data.heroTitle is string && data.heroTitle.size() < 500 &&
             data.heroSubtitle is string && data.heroSubtitle.size() < 1000 &&
             data.aboutText is string && data.aboutText.size() < 5000 &&
             data.email is string &&
             data.instagram is string &&
             data.consultantName is string &&
             data.consultantTitle is string;
    }

    // Rules
    
    match /services/{serviceId} {
      allow read: if true; // Publicly readable
      allow create, update, delete: if isAdmin() && isValidService(request.resource.data);
    }
    
    match /settings/{settingId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin() && isValidSettings(request.resource.data);
    }

    match /appointments/{appointmentId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone', 'service', 'status', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
